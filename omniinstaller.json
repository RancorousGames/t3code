{
  "schemaVersion": 1,
  "repository": { "url": "https://github.com/RancorousGames/t3code" },
  "apps": [
    {
      "id": "dev.rancorousgames.t3code",
      "name": "T3 Code",
      "workingDirectory": ".",
      "defaultDestination": "{LocalAppData}/OmniInstaller/Apps/{AppId}",
      "sources": { "git": {} },
      "prerequisites": [
        {
          "id": "node",
          "detect": { "script": "scripts/omniinstaller-t3.ps1", "args": ["checkNode"] },
          "installHint": "Install the Node.js version pinned in this checkout's package.json and put it on PATH."
        },
        {
          "id": "vite-plus",
          "detect": { "script": "scripts/omniinstaller-t3.ps1", "args": ["checkVp"] },
          "installHint": "Install Vite+ for Windows (https://viteplus.dev/guide/) and put vp on PATH."
        },
        {
          "id": "rust",
          "detect": { "script": "scripts/omniinstaller-t3.ps1", "args": ["checkRust"] },
          "installHint": "Install Rust and run rustup target add x86_64-pc-windows-msvc."
        },
        {
          "id": "msvc",
          "detect": { "script": "scripts/omniinstaller-t3.ps1", "args": ["checkMsvc"] },
          "installHint": "In Visual Studio Installer, add Desktop development with C++, the Windows SDK, and the latest MSVC x64/x86 Spectre-mitigated libraries. The build also requires Python 3."
        }
      ],
      "commands": {
        "build": { "script": "scripts/omniinstaller-t3.ps1", "args": ["build"] },
        "install": { "script": "scripts/omniinstaller-t3.ps1", "args": ["install"] },
        "detectVersion": { "script": "scripts/omniinstaller-t3.ps1", "args": ["detectVersion"] },
        "uninstall": { "script": "scripts/omniinstaller-t3.ps1", "args": ["uninstall"] },
        "launch": { "executable": "{InstallDir}/app/T3 Code.exe" }
      }
    }
  ]
}
